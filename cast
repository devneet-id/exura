#!/usr/bin/env php
<?php
/**
 * Act. 1 - Understanding Its Flow
 * THE AWAKENING ✦
 *
 * From the silence of nothingness, echoes rise from the void.
 * A journey begins — with runes at your side.
 *
 * Run this script using:
 *   $ php {file}
 *   $ php {file} grimoire
 */
require_once __DIR__ . '/vendor/autoload.php';

/**
 * I N V O C A T I O N
 *
 * Step 1 — Summon the runes:
 * Import each module's manifest.
 *
 * Step 2 — Channel the energy:
 * Initialize ether, essence, and entity.
 *
 * Note: Keep #sentinel markers if you're using Sentinel support.
 */
use Rune\Aether\Manifest as Aether;
use Rune\Whisper\Manifest as Whisper;
use Rune\Weaver\Manifest as Weaver;
use Rune\Chanter\Manifest as Chanter;
use Rune\Forger\Manifest as Forger;
use Rune\Crafter\Manifest as Crafter;
use Rune\Keeper\Manifest as Keeper;
use Rune\Cipher\Manifest as Cipher;
use Rune\Specter\Manifest as Specter;
#sentinel-manifest

Aether::ether()::essence()::entity();
Whisper::ether()::essence()::entity();
Weaver::ether()::essence()::entity();
Chanter::ether()::essence()::entity();
Forger::ether()::essence()::entity();
Crafter::ether()::essence()::entity();
Keeper::ether()::essence()::entity();
Cipher::ether()::essence()::entity();
Specter::ether()::essence()::entity();
#sentinel-awaken

/**
 * I N C A N T A T I O N
 *
 * This is your working space.
 * Use begin() and end() to define the active logic scope.
 */
Aether::begin();
Chanter::begin();
Keeper::begin();

// ✦ Main logic lives here

/* FETCH
 * todo take exuracss & exurajs and paste them into src/
 * from the release tag on jsDelivr (default) or the sibling repos on disk (--local=true)
 * */
const EXURA_CDN = 'https://cdn.jsdelivr.net/gh/devneet-id';
const EXURA_VERSION = '1.1.0'; // release tag of exuracss & exurajs (devneet-id)
const EXURA_FETCH = [
  // src/ file           => [sibling repo file (--local),    CDN path at the release tag]
  'src/exura.css'      => ['../exuracss/dist/exura.min.css', 'exuracss@' . EXURA_VERSION . '/dist/exura.min.css'],
  'src/exura-clip.css' => ['../exuracss/dist/exura-clip.css', 'exuracss@' . EXURA_VERSION . '/dist/exura-clip.css'],
  'src/exura.js'       => ['../exurajs/dist/exura.min.js',  'exurajs@' . EXURA_VERSION . '/dist/exura.min.js'],
];

Chanter::cast(
  arg: 'fetch --local',
  echo: 'take exuracss & exurajs @' . EXURA_VERSION . ' into src/ (--local=true: from ../exuracss, ../exurajs)',
  execute: function() {
    $local = Chanter::spell('local') == 'true';
    foreach (EXURA_FETCH as $target => [$sibling, $remote]) {
      $from = $local ? __DIR__ . '/' . $sibling : EXURA_CDN . '/' . $remote;
      $source = @file_get_contents($from);
      if ($source === false || $source === '') {
        Whisper::echo("{{color-danger}}{{icon-warning}} cannot read $from{{nl}}");
        continue;
      }
      Forger::item(__DIR__ . '/' . $target, $source);
      Whisper::echo("{{color-success}}{{icon-success}} $target{{color-end}} ← $from{{nl}}");
    }
  }
);

/* BUILD
 * todo bundling to website applications 
 * [i]INFO: crafting process will be reset your shard in .echoes
 * [!]NOTE: Crafter binds {{HTML}} {{CSS}} {{JS}} {{PHP}} (any case) — don't use those names as exurajs keys
 * */
Chanter::cast(
  arg: 'build',
  echo: 'bundling to website applications',
  execute: function() {
    // create crafting environment
    Crafter::item('app', function() {
      // set seeds
      Crafter::seed('DIST', __DIR__ . '/index.html'); // distribution file output
      Crafter::seed('TYPE', 'plain'); // plain (HTML,CSS,JS) or function, class (PHP only)
      Crafter::seed('LANGUAGE', ['html','css','js']); // web language only 4 html, css, js, php
      
      // set shards one by one
      Crafter::shard('src/index.head.html'); // privately for HTML <head>
      Crafter::shard('src/index.html'); // HTML <body>
      Crafter::shard('src/exura.css'); // php cast fetch
      Crafter::shard('src/exura-clip.css'); // php cast fetch
      Crafter::shard('src/index.module.css'); // look of the page (module-1)
      Crafter::shard('src/index.css');
      Crafter::shard('src/exura.js'); // php cast fetch
      Crafter::shard('src/index.js');
      // Crafter::shard('src/index.php');
    });
    // run crafting
    Crafter::spark('app');
  }
);

#sentinel-codex
Keeper::end();
Chanter::end();
Aether::end();
